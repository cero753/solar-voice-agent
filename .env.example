# Copy to .env and fill in. Do NOT commit .env.
# Server-side only (Netlify functions + agent/test scripts). Never exposed to the browser.
ELEVENLABS_API_KEY=your_elevenlabs_api_key
AGENT_ID=your_agent_id_from_create-agent_script

# Client-side (Vite exposes only VITE_-prefixed vars to the browser)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
